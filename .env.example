# Copy to .env and fill in. The pipeline picks a provider in this order:
#   1. LLM_MODEL, if set
#   2. Gemini, if GOOGLE_API_KEY is set
#   3. Anthropic, if ANTHROPIC_API_KEY is set

# Preferred — https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Fallback. Must be a real Anthropic API key; a Claude Code proxy token will be
# rejected with "please use the standard Claude Code client".
# ANTHROPIC_API_KEY=

# Optional explicit override, e.g. google_genai:gemini-2.5-pro
# LLM_MODEL=
